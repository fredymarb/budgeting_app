<div class="category-budget-row" role="row">
  <div class="category-name-cell" role="cell">
    <span class="category-checkbox" aria-hidden="true"></span>
    <div class="category-name-content">
      <span class="category-name"><%= @category.name %></span>
      <% if funding_label.present? %>
        <span class="category-funding-label"><%= funding_label %></span>
      <% end %>
      <% if @budgeted_minor.positive? %>
        <span
          class="category-progress"
          role="progressbar"
          aria-label="Spent from <%= @category.name %> budget"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="<%= spending_percent %>">
          <span class="category-progress-fill" style="width: <%= spending_percent %>%"></span>
        </span>
      <% end %>
    </div>
  </div>
  <div class="category-number category-budgeted-edit" role="cell">
    <details>
      <summary><%= helpers.budget_money(@budgeted_minor, currency: @currency) %></summary>
      <%= form_with url: allocation_path, method: allocation_method, scope: :monthly_allocation do |form| %>
        <%= form.hidden_field :budget_month, value: @budget_month.beginning_of_month %>
        <%= form.label :assigned_amount, "Budgeted amount for #{@category.name}", class: "visually-hidden" %>
        <%= form.text_field :assigned_amount, value: budgeted_amount, inputmode: "decimal", required: true, autocomplete: "off" %>
        <%= form.submit "Save" %>
      <% end %>
    </details>
  </div>
  <div class="category-number category-activity" role="cell"><%= helpers.budget_money(@activity_minor, currency: @currency) %></div>
  <div class="category-number" role="cell">
    <span class="category-available <%= available_class %>">
      <%= helpers.budget_money(@available_minor, currency: @currency) %>
    </span>
  </div>
</div>
